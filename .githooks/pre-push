#!/usr/bin/env bash
# Blocks a push when the commits being pushed contain a secret (gitleaks, .gitleaks.toml).
# Installed by `npm run prepare` (core.hooksPath=.githooks).
set -euo pipefail

remote="$1"
zero="0000000000000000000000000000000000000000"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks not found; install it (brew install gitleaks) and push again" >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # A delete pushes nothing to scan.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  # Scan only commits the remote doesn't have yet (works for a new branch too).
  if ! gitleaks git "$root" --config "$root/.gitleaks.toml" --redact --no-banner --verbose \
    --log-opts="$local_sha --not --remotes=$remote"; then
    echo "pre-push: gitleaks found a secret in $local_ref; push blocked" >&2
    status=1
  fi
done

exit "$status"
